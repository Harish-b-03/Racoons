# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fitness_tracker
DB_USER=postgres
DB_PASSWORD=secretpassword

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Server Configuration
SERVER_PORT=8080

# JWT Configuration
JWT_SECRET=your-256-bit-secret-change-this-in-production-must-be-at-least-256-bits-long-for-hs256
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Location Settings
MAX_LOCATION_AGE=30
DEFAULT_RADIUS=1000
MAX_RADIUS=50000
LOCATION_BATCH_SIZE=100

# WebSocket Settings
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=3
WS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
